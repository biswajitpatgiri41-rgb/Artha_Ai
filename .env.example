# ============================================================
# NVIDIA API CONFIGURATION
# ============================================================

# Get your API key from:
# https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# NVIDIA OpenAI-compatible API base URL
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Single model used by ALL agents and contextual assistant
NVIDIA_MODEL=google/diffusiongemma-26b-a4b-it

# Evidence embeddings are independent of the chat/agent model.
# local uses a local hashing provider by default; an optional Sentence Transformers model can be set explicitly.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-v1

# Runtime evidence upload and parser limits
MAX_UPLOAD_MB=50
MAX_FILES_PER_RUN=20
MAX_PDF_PAGES=500
MAX_CSV_ROWS=100000
MAX_XLSX_SHEETS=50
MAX_JSON_BYTES=10000000
EVIDENCE_RETENTION_HOURS=24


# ============================================================
# NVIDIA REQUEST CONFIGURATION
# ============================================================

# Maximum response/read timeout in seconds
NVIDIA_TIMEOUT_SECONDS=120

# TCP/TLS connection timeout in seconds
NVIDIA_CONNECT_TIMEOUT=10

# Maximum retries for transient failures
NVIDIA_MAX_RETRIES=1

# Maximum simultaneous NVIDIA API requests
NVIDIA_MAX_CONCURRENT_REQUESTS=2


# ============================================================
# CORS CONFIGURATION
# ============================================================

CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]

# Optional: comma-separated IP addresses of reverse proxies you control.
# Forwarded client IP headers are ignored unless the immediate peer matches this list.
# TRUSTED_PROXY_IPS=127.0.0.1,10.0.0.10


# ============================================================
# EXTERNAL DATA SOURCE API KEYS
# ============================================================

# EIA (U.S. Energy Information Administration) API Key
# Get your API key from: https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key_here

# FRED (Federal Reserve Economic Data) API Key
# Get your API key from: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# World Bank API (no key required for basic access)
# WORLD_BANK_API_KEY=


# ============================================================
# ADMIN AUTHENTICATION CONFIGURATION
# ============================================================

# Admin user email (required for admin panel login)
# ADMIN_EMAIL=admin@indiamacro.ai

# Admin user password hash (Argon2id) - generate with: python -c "from passlib.context import CryptContext; pwd = CryptContext(schemes=['argon2']); print(pwd.hash('your_secure_password'))"
# ADMIN_PASSWORD=$argon2id$v=19$m=65536,t=3,p=4$...hashed_password...

# Admin user role: ADMIN, SUPER_ADMIN, RESEARCHER, ANALYST, VIEWER
# ADMIN_ROLE=ADMIN

# Development-only login bypass (MUST be false in production!)
# When enabled, allows login with ADMIN_DEV_BYPASS_EMAIL / ADMIN_DEV_BYPASS_PASSWORD
# without requiring ADMIN_EMAIL / ADMIN_PASSWORD to be configured.
# ADMIN_DEV_BYPASS=false
# ADMIN_DEV_BYPASS_EMAIL=dev@local
# ADMIN_DEV_BYPASS_PASSWORD=dev-only-bypass-do-not-use-in-production


# ============================================================
# JWT & SESSION CONFIGURATION
# ============================================================

# JWT secret key for signing tokens (MUST be at least 32 chars in production)
# Generate with: openssl rand -base64 32
# JWT_SECRET_KEY=your_jwt_secret_key_here

# JWT algorithm (HS256 or RS256)
# JWT_ALGORITHM=HS256

# Access token expiration in minutes
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration in days
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Session cookie settings
# SESSION_COOKIE_NAME=session
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_HTTPONLY=true
# SESSION_COOKIE_SAMESITE=lax
# SESSION_MAX_AGE_SECONDS=1800

# Environment (development, staging, production)
ENVIRONMENT=development
# For separate production services, set the admin server-side rewrite target
# at build time. This value is not exposed to browser code.
# BACKEND_INTERNAL_URL=http://api:8000
